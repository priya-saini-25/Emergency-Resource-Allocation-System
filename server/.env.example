# ==============================================================================
# EMERGENCY RESOURCE ALLOCATION SYSTEM - BACKEND ENVIRONMENT CONFIGURATION
# Academic Emergency Dispatch Simulation for Jodhpur, Rajasthan
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGIN=*

# MongoDB Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.n1kxy3m.mongodb.net/

# Authentication & Security
# WARNING: Always set a strong, random 32+ character secret in production!
JWT_SECRET=replace_with_a_random_code
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# Privileged Initial Account Provisioning (Idempotent seed bootstrap)
ADMIN_INITIAL_EMAIL=admin@jodhpur.emergency.gov.in
ADMIN_INITIAL_PASSWORD=Change_Me_Admin
OPERATOR_INITIAL_EMAIL=operator@jodhpur.emergency.gov.in
OPERATOR_INITIAL_PASSWORD=Change_Me_Operator

# C++ Decision Engine Executable & Data Paths
# Relative to server root or absolute filesystem paths
CPP_ENGINE_PATH=../cpp_engine/bin/engine.exe
CPP_DATA_DIR=../cpp_engine/data
CPP_TIMEOUT_MS=10000
CPP_MAX_BUFFER_BYTES=10485760

# Geographic Service Perimeter (OpenStreetMap Way 31725312 academic proxy)
JODHPUR_BOUNDARY_PATH=../cpp_engine/data/jodhpur_boundary.geojson
JODHPUR_CENTER_LAT=26.2918
JODHPUR_CENTER_LNG=73.0168

# Optional: Path to MSYS2 UCRT64 toolchain binaries on Windows for dynamic C++ runtime DLLs
CPP_EXTRA_PATH=C:\msys64\ucrt64\bin
