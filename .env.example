# ==============================================================================
# EMERGENCY RESOURCE ALLOCATION SYSTEM - ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env and adjust variables as needed.
# NOTE: Never commit sensitive credentials or real secrets to source control.
# ==============================================================================

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# --- MongoDB Database (Planned for Phase 2) ---
MONGODB_URI=mongodb://localhost:27017/emergency_response_jodhpur

# --- C++ Engine Executable Path ---
# Path relative to server root or absolute path to compiled binary
CPP_ENGINE_BIN_PATH=../cpp_engine/bin/engine.exe
CPP_ENGINE_TIMEOUT_MS=5000

# --- Jodhpur Geographic Service Perimeter ---
# Bounding coordinates for point-in-polygon & validation services
JODHPUR_CENTER_LAT=26.2918
JODHPUR_CENTER_LNG=73.0168

# --- Frontend Configuration (Client) ---
# Vite variables must be prefixed with VITE_
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_REGION="Jodhpur City, Rajasthan (Simulation)"
VITE_DEMO_MODE=true
