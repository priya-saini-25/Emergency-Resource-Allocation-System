# ==============================================================================
# EMERGENCY RESOURCE ALLOCATION SYSTEM - ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env and adjust variables as needed.
# NOTE: Never commit sensitive credentials or real secrets to source control.
# ==============================================================================

# --- Backend Configuration ---
PORT=5000
NODE_ENV=development
API_PREFIX=/api
CORS_ORIGIN=*

# --- MongoDB Database ---
MONGODB_URI=mongodb+srv://<username>:<passwords>@cluster0.n1kxy3m.mongodb.net/

# --- Authentication & JWT Security ---
JWT_SECRET=replace_with_a_random_code
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# --- Privileged Initial Account Provisioning ---
ADMIN_INITIAL_EMAIL=admin@jodhpur.emergency.gov.in
ADMIN_INITIAL_PASSWORD=Change_Me_Admin
OPERATOR_INITIAL_EMAIL=operator@jodhpur.emergency.gov.in
OPERATOR_INITIAL_PASSWORD=Change_Me_Operator

# --- C++ Engine Executable & Data Paths ---
CPP_ENGINE_BIN_PATH=../cpp_engine/bin/engine.exe
CPP_DATA_DIR=../cpp_engine/data
CPP_ENGINE_TIMEOUT_MS=10000
CPP_MAX_BUFFER_BYTES=10485760
CPP_EXTRA_PATH=C:\msys64\ucrt64\bin

# --- Jodhpur Geographic Service Perimeter ---
JODHPUR_BOUNDARY_PATH=../cpp_engine/data/jodhpur_boundary.geojson
JODHPUR_CENTER_LAT=26.2918
JODHPUR_CENTER_LNG=73.0168

# --- Frontend Configuration (Client) ---
VITE_API_BASE_URL=http://localhost:5000/api
VITE_APP_REGION="Jodhpur City, Rajasthan (Simulation)"
VITE_DEMO_MODE=true
